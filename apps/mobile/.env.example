# 이 파일을 복사해 .env를 만든다:  copy .env.example .env
# .env는 .gitignore 대상이다. EXPO_PUBLIC_ 값은 앱 번들에 그대로 들어가므로 비밀값을 넣지 않는다.

# 게임 API 서버 주소 (끝에 /v1은 붙이지 않는다)
# - Expo 웹·iOS 시뮬레이터: http://localhost:8000
# - Android 에뮬레이터: http://10.0.2.2:8000 (에뮬레이터에서 PC를 가리키는 고정 주소)
# - 실제 기기(Expo Go): http://<PC의 LAN IP>:8000, 서버는 --host 0.0.0.0 으로 실행
EXPO_PUBLIC_API_URL=http://localhost:8000
