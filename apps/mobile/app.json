{
  "expo": {
    "name": "말꼬리",
    "slug": "wordchain",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wordchain",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rangcloud.wordchain",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rangcloud.wordchain"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c98f7601-6b62-4a93-a915-37c1d8f756a0"
      }
    },
    "owner": "rangcloud"
  }
}
