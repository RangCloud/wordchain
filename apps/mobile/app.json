{
  "expo": {
    "name": "말꼬리",
    "slug": "wordchain",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wordchain",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rangcloud.wordchain",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rangcloud.wordchain",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#1E5E40"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF5",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F1411"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c98f7601-6b62-4a93-a915-37c1d8f756a0"
      }
    },
    "owner": "rangcloud"
  }
}
